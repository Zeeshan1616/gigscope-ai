# ==============================================================================
# GIGSCOPE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: All API keys and secrets in this file are SERVER-SIDE only.
# NEVER prefix secret keys with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider to use for classification, market analysis, and content optimization.
# Supported options:
#   - "openrouter" : Recommended for Nemotron 3.5 Lightning (https://openrouter.ai)
#   - "nvidia"     : NVIDIA NIM API (https://build.nvidia.com)
#   - "openai"     : Standard OpenAI endpoint (https://platform.openai.com)
#   - "custom"     : Any OpenAI-compatible endpoint (Ollama, vLLM, Groq, etc.)
AI_PROVIDER=openrouter

# Model Identifier:
# Default preferred model is NVIDIA Nemotron 3.5 Lightning:
# - On OpenRouter: "nvidia/nemotron-3.5-lightning" or "nvidia/llama-3.1-nemotron-70b-instruct"
# - On NVIDIA NIM: "nvidia/nemotron-3.5-lightning"
# - On OpenAI: "gpt-4o-mini"
AI_MODEL=nvidia/nemotron-3.5-lightning

# Base URL for the OpenAI-compatible API:
# - OpenRouter: https://openrouter.ai/api/v1
# - NVIDIA NIM: https://integrate.api.nvidia.com/v1
# - OpenAI:     https://api.openai.com/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# API Key for your AI Provider (Required for production AI generation):
# If not set during local evaluation, the application provides detailed guidance
# and graceful fallback analysis with real research provenance.
AI_API_KEY=your_ai_api_key_here

# ------------------------------------------------------------------------------
# 2. MARKET RESEARCH PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Search engine provider for live competitor and market research.
# Supported options:
#   - "duckduckgo" : Free public search engine (zero API key required, live queries)
#   - "tavily"     : Tavily Search API (https://tavily.com - recommended for production)
#   - "serper"     : Google Serper API (https://serper.dev)
RESEARCH_PROVIDER=duckduckgo

# Optional API keys for premium search providers:
TAVILY_API_KEY=
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 3. SECURITY & SAFETY LIMITS
# ------------------------------------------------------------------------------
# Maximum requests allowed per IP per time window (in-memory rate limiter)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000

# Maximum duration (ms) for external web retrieval requests (SSRF & timeout protection)
MAX_FETCH_TIMEOUT_MS=8000

# Maximum response size (bytes) to accept from an external webpage (512 KB)
MAX_FETCH_BODY_BYTES=524288
